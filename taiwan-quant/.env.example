# taiwan-quant 環境變數範本
#
# 用法：
#   cp .env.example .env
#   然後把佔位字串換成真實值
#
# ⚠️ .env 已在 .gitignore，不會被提交。**不要把真實值填進 .env.example。**
# ⚠️ 秘密只走環境變數或 .env，不可硬編碼進程式（CLAUDE.md 程式風格）。
#
# 已匯出的環境變數優先於本檔（load_env 的 override=False）：
#   FINMIND_API_TOKEN=xxx .venv/bin/python scripts/backfill_finmind_history.py
# 這種一次性覆寫有效。

# ─────────────────────────────────────────────────────────────
# FinMind API token
# ─────────────────────────────────────────────────────────────
#
# ⚠️ 同一個 token 有兩個變數名，兩個都在用，**兩個都要填同一個值**：
#
#   FINMIND_API_TOKEN   taiwan-quant/scripts/backfill_finmind_history.py
#                       taiwan-quant/scripts/backfill_adj_from_dividends.py
#   FINMIND_KEY         qlib-tw-trader/src/services/sync_service.py
#                       qlib-tw-trader/src/interfaces/routers/datasets.py
#
# 只填一個會讓另一側**靜默**走匿名層——額度被砍但不會有任何訊息。
#
# 免費方案可以留空（走匿名層，有 request 上限）。

FINMIND_API_TOKEN=paste_your_finmind_token_here
FINMIND_KEY=paste_your_finmind_token_here

# ─────────────────────────────────────────────────────────────
# Telegram 推播（選填）
# ─────────────────────────────────────────────────────────────
#
# 未設定時 notify/telegram.py 走 dry-run，不會拋錯。
# 填佔位字串等於沒填——config/env.py 的 PLACEHOLDER_VALUES 會擋掉。

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ─────────────────────────────────────────────────────────────
# LightGBM 裝置（選填）
# ─────────────────────────────────────────────────────────────
#
# gpu / cpu。未設定時 model_trainer 會實測一次自動判定。
# 只有 qlib-tw-trader 在讀。

# LGB_DEVICE=cpu
